# ChromaSAR / Delta Force - what must never reach the repo.
#
# The numbers below are what these actually measure on the dev box, because the whole
# point of this file is that `git add .` stays safe. Without it the first commit tries
# to carry 460 MB of reinstallable dependencies.

# ---------------------------------------------------------------- dependencies
# 346 MB. Reinstalled with `npm install` - never committed.
frontend/node_modules/
node_modules/

# 114 MB of build output. Regenerated by `npm run dev` / `npm run build`.
frontend/.next/
frontend/out/
.next/
out/
build/
dist/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtualenvs are machine-specific: the scripts inside hardcode absolute paths, so a
# committed venv is broken the moment it lands on another laptop.
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------- model + data
# The corpus lives OUTSIDE this folder, at $SIH_DATA (default ~/sih-data), 57 GB of it.
# These patterns are a backstop in case anyone ever copies it inside the project.
sih-data/
data/
runs/
wandb/

# Checkpoints are 93.5 MB each. That is under GitHub's 100 MB hard limit but over its
# 50 MB warning, and five of them would eat the free 1 GB LFS quota outright. They
# travel by USB - see SETUP.md.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Large rasters in general. demo-uploads/ is deliberately NOT ignored - those seven
# small chips are what make a fresh clone demoable, so they are worth their 12.7 MB.
*.SAFE/
*.zip
*.tar
*.tar.gz
*.h5
*.hdf5
*.npz

# ---------------------------------------------------------------- secrets
# Nothing matching these exists today (verified before the first push) and nothing
# should. The Modal token in particular lives in ~/.modal.toml, outside this tree.
.env
.env.*
!.env.example
*.pem
*.key
credentials*
.modal.toml
secrets.json

# ---------------------------------------------------------------- local-only
# launch.json IS committed - the team needs it to start the dev server.
# settings.local.json is per-machine permission state and is not.
.claude/settings.local.json

.vscode/
.idea/
*.swp
*~

# ---------------------------------------------------------------- os junk
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
